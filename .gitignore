# --- Patient data: NEVER committed -------------------------------------------
# METABRIC is access-controlled (EGA EGAS00000000083 / Synapse syn1688369).
# Redistributing it via this repo would breach the data access agreement.
data/**
!data/**/
!data/**/.gitkeep
!data/raw/CHECKSUMS.sha256

# --- Generated artefacts ------------------------------------------------------
# Everything here is reproducible from code + config + seed. Committing it
# invites stale numbers in the thesis. See docs/experimental-design.md.
outputs/**
!outputs/**/
!outputs/**/.gitkeep

# --- Synthetic test fixture ---------------------------------------------------
# Generated by tests/conftest.py on first run. No .csv ever enters git, so the
# data rule stays absolute (.githooks/pre-commit enforces it).
tests/fixtures/*.csv

# --- Python -------------------------------------------------------------------
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Notebooks ----------------------------------------------------------------
.ipynb_checkpoints/

# --- SLURM --------------------------------------------------------------------
slurm-*.out
logs/

# --- Editors / OS -------------------------------------------------------------
.DS_Store
.vscode/
.idea/
